#-----------------------------------------------------
if SHIELD_SOFLE_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif #SHIELD_SOFLE_LEFT
#-----------------------------------------------------
if SHIELD_SOFLE_RIGHT

config INPUT_TPS43
    default y

endif #SHIELD_SOFLE_RIGHT

if SHIELD_SOFLE_LEFT || SHIELD_SOFLE_RIGHT

if ZMK_DISPLAY

config I2C
    default y
config SSD1306
    default y

endif #ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64
config LV_DPI_DEF
    default 148
config LV_Z_BITS_PER_PIXEL
    default 1
choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif #LVGL

endif #SHIELD_SOFLE_LEFT || SHIELD_SOFLE_RIGHT